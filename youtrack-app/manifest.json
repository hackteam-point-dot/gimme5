{
  "name": "app",
  "title": "GiveMeFive",
  "description": "Gamification plugin",
  "$schema": "https://json.schemastore.org/youtrack-app.json",
  "vendor": {
    "name": "",
    "url": "https://www.jetbrains.com/"
  },
  "icon": "icon.svg?v=2",
  "widgets": [
    {
      "key": "gimme5_user_rating",
      "name": "GiveMeFive user rating dashboard",
      "indexPath": "user-dashboard/index.html",
      "extensionPoint": "DASHBOARD_WIDGET",
      "iconPath": "user-dashboard/widget-icon.svg",
      "description": "Shows user rating in GiveMeFive system"
    },
    {
      "key": "gimme5_user_card",
      "name": "Honor board",
      "indexPath": "user-card/index.html",
      "extensionPoint": "USER_CARD",
      "iconPath": "user-card/widget-icon.svg",
      "description": "Shows user card in GiveMeFive system"
    },
    {
      "key": "gimme5_team_rating",
      "name": "GiveMeFive team rating dashboard",
      "indexPath": "team-dashboard/index.html",
      "extensionPoint": "DASHBOARD_WIDGET",
      "iconPath": "team-dashboard/widget-icon.svg",
      "description": "Shows team rating in GiveMeFive system"
    },
    {
      "key": "gimme5_admin_panel",
      "name": "GiveMeFive Admin Panel",
      "indexPath": "admin-panel/index.html",
      "extensionPoint": "ADMINISTRATION_MENU_ITEM",
      "iconPath": "admin-panel/widget-icon.svg",
      "description": "Configuration panel for GiveMeFive project settings (admin only)"
    }
  ]
}